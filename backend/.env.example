# Copy to .env for local (non-docker) runs. docker-compose.yml sets these
# directly as container env vars instead of reading this file.
DATABASE_URL=postgresql+asyncpg://claims:claims@localhost:5432/claims
VISION_BACKEND=mock
CONSISTENCY_BACKEND=rules

# --- hosted LLM gateway (all optional; empty keys = provider skipped) ---
# Free keys, no card needed for Groq/OpenRouter. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# any model ID ending in ":free" from OpenRouter's model list
OPENROUTER_MODEL=
LLM_TEXT_PROVIDERS=groq,openrouter,mock
LLM_VISION_PROVIDERS=gemini,mock
# optional local fallback via Ollama, e.g. http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3:4b
LLM_CACHE_PATH=data/llm_cache.sqlite3

# --- privacy guard: leave false. See app/services/privacy_guard.py ---
ALLOW_RESTRICTED_TO_HOSTED=false
